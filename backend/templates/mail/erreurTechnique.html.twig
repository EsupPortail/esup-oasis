{% extends 'mail/base.html.twig' %}
{% block body %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="body">
        <tr>
            <td>&nbsp;</td>
            <td class="container">
                <div class="content">

                    <table role="presentation" class="main">

                        <tr>
                            <td class="wrapper">
                                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td align="center">
                                            <a href="{{ frontUrl }}" referrerpolicy="no-referrer"
                                               target="_blank"
                                               aria-label="Se rendre sur le site {{ APP_TITRE }}">
                                                <img border="0" class="img-responsive"
                                                     src="{{ backUrl }}{{ APP_LOGO }}"
                                                     alt="" aria-hidden="true" style="max-width: 300px"/></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                                <tr>
                                                    <td>
                                                        <h1>
                                                            Erreur technique
                                                        </h1>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <p>Bonjour,</p>
                                            <p>{{ APP_TITRE }} vient de rencontrer l'erreur technique suivante :</p>
                                            <p><strong>{{ message }}</strong></p>
                                            <p>Détails :</p>
                                            <p><strong>{{ exceptionMessage }}</strong></p>
                                            <ul>
                                                {% for ligne in  trace %}
                                                    <li>{{ ligne.file }}, ligne {{ ligne.line }},
                                                        méthode {{ ligne.function }}</li>
                                                {% endfor %}
                                            </ul>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                    </table>

                    <div class="footer">

                        <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <a
                                            href="{{ APP_ETABLISSEMENT_URL }}" referrerpolicy="no-referrer"
                                            target="_blank">
                                        <img border="0" width="50" style="width: 50px"
                                             src="{{ backUrl }}{{ APP_LOGO_FOOTER_MAILS }}"
                                             alt="Logo {{ APP_ETABLISSEMENT }}"/>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="content-block">
                                <span class="apple-link"><a
                                            href="{{ APP_ETABLISSEMENT_URL }}" referrerpolicy="no-referrer"
                                            target="_blank">{{ APP_ETABLISSEMENT }}</a> • <a
                                            href="{{ frontUrl }}" referrerpolicy="no-referrer"
                                            target="_blank">{{ APP_TITRE }}</a></span>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </td>
            <td>&nbsp;</td>
        </tr>
    </table>

{% endblock %}