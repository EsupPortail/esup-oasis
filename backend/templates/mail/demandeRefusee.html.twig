{% extends 'mail/base.html.twig' %}

{% block body %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="body">
        <tr>
            <td>&nbsp;</td>
            <td class="container">
                <div class="content">
                    <table role="presentation" class="main">
                        <tr>
                            <td class="wrapper">
                                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td align="center">
                                            <a href="{{ frontUrl }}" referrerpolicy="no-referrer"
                                               target="_blank"
                                               aria-label="Se rendre sur le site {{ APP_TITRE }}">
                                                <img border="0" class="img-responsive"
                                                     src="{{ backUrl }}{{ APP_LOGO }}"
                                                     alt="" aria-hidden="true" style="max-width: 300px"/></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                                <tr>
                                                    <td>
                                                        <h1>
                                                            Votre demande est refusée
                                                        </h1>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <p>Bonjour,</p>
                                            <p>Votre dossier "{{ typeDemande.libelle }}" ne répond malheureusement pas
                                                aux critères de ce type de demandes, nous ne pouvons y donner suite.</p>
                                            <p>{{ commentaire }}</p>
                                            {% if typeDemande.estPourSportifs() %}
                                                <p>Pour toutes questions, vous pouvez contacter
                                                    <a href="mailto:{{ APP_SERVICE_SPORTIFS_EMAIL }}">
                                                        {{ APP_SERVICE_SPORTIFS_DENOMINATION|articleDefini(APP_SERVICE_SPORTIFS_ARTICLE) }}
                                                        {{ APP_ETABLISSEMENT|articleDefiniContracte(APP_ETABLISSEMENT_ARTICLE) }}
                                                        .</a></p>
                                            {% else %}
                                                <p>Pour toutes questions, vous pouvez contacter la personne en
                                                    charge de l'accompagnement spécifique de votre
                                                    campus. Vous trouverez son contact sur cette page&nbsp;:
                                                    <a href="{{ APP_URL_SERVICE }}">Étudiants
                                                        à besoins spécifiques</a>.
                                                </p>
                                            {% endif %}
                                            <p class="last">{{ APP_SERVICE_DENOMINATION|articleDefini(APP_SERVICE_ARTICLE|capitalize) }}
                                                .</p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <div class="footer">

                        <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <a
                                            href="{{ APP_ETABLISSEMENT_URL }}" referrerpolicy="no-referrer"
                                            target="_blank">
                                        <img border="0" width="50" style="width: 50px"
                                             src="{{ backUrl }}{{ APP_LOGO_FOOTER_MAILS }}"
                                             alt="Logo {{ APP_ETABLISSEMENT }}"/>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="content-block">
                                <span class="apple-link"><a
                                            href="{{ APP_ETABLISSEMENT_URL }}" referrerpolicy="no-referrer"
                                            target="_blank">{{ APP_ETABLISSEMENT }}</a> • <a
                                            href="{{ frontUrl }}" referrerpolicy="no-referrer"
                                            target="_blank">{{ APP_TITRE }}</a></span>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </td>
            <td>&nbsp;</td>
        </tr>
    </table>
{% endblock %}

